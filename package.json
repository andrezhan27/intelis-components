{
  "name": "@intelis/restaurant-ui",
  "version": "0.1.0",
  "description": "Shared native UI for Intelis restaurant websites and dashboards.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dashboard": {
      "types": "./dist/dashboard/index.d.ts",
      "import": "./dist/dashboard/index.js",
      "default": "./dist/dashboard/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/promotion-banner/promotion-banner.module.css dist/promotion-banner/promotion-banner.module.css && cp src/dashboard/promotion-manager.module.css dist/dashboard/promotion-manager.module.css",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "@supabase/supabase-js": ">=2.50.0 <3",
    "next": ">=16.0.0 <17",
    "react": ">=19.0.0 <20"
  },
  "peerDependenciesMeta": {
    "@supabase/supabase-js": {
      "optional": true
    }
  },
  "dependencies": {
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.110.0",
    "@types/node": "22.10.0",
    "@types/react": "19.2.2",
    "next": "16.3.0",
    "react": "19.2.8",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED"
}
